
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Scamabon™ — The Online Superstore</title>

<style>
* { box-sizing: border-box; }

body {
  margin: 0;
  background: #fff5cf;
  color: #252015;
  font-family: Arial, Helvetica, sans-serif;
}

header {
  background: #e73518;
  color: white;
  padding: 25px 15px;
  text-align: center;
  border-bottom: 6px solid #ffc928;
}

.logo {
  font-size: clamp(38px, 8vw, 72px);
  font-weight: 1000;
  letter-spacing: -3px;
  text-shadow: 4px 4px #772010;
  margin: 0;
}

header p {
  margin-bottom: 0;
  font-weight: bold;
}

.shipping {
  background: #242015;
  color: #ffe65b;
  padding: 11px;
  text-align: center;
  font-weight: bold;
  font-size: 13px;
}

nav {
  background: #ffca32;
  padding: 15px;
  text-align: center;
}

nav a {
  color: #252015;
  font-weight: bold;
  text-decoration: none;
  margin: 0 12px;
  font-size: 14px;
}

nav a:hover { text-decoration: underline; }

main {
  max-width: 1100px;
  padding: 20px;
  margin: auto;
}

.hero {
  background: #ff4e91;
  color: white;
  text-align: center;
  padding: 35px 15px;
  border: 4px solid #252015;
  box-shadow: 6px 6px #252015;
}

.hero h2 {
  font-size: clamp(27px, 5vw, 44px);
  margin: 0 0 10px;
}

.hero p { margin-bottom: 0; }

.notice {
  margin-top: 18px;
  padding: 12px;
  background: #fff;
  border: 2px dashed #e73518;
  text-align: center;
  font-size: 13px;
}

.section-heading {
  margin-top: 35px;
  border-bottom: 4px solid #252015;
  padding-bottom: 10px;
}

.products {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 20px;
}

.product {
  background: white;
  border: 2px solid #252015;
  box-shadow: 4px 4px #252015;
  padding: 12px;
  position: relative;
}

.product-art {
  background: #f4e9d4;
  min-height: 175px;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 82px;
  border: 1px solid #ddd0b7;
}

.tag {
  display: inline-block;
  background: #e73518;
  color: white;
  font-size: 11px;
  font-weight: bold;
  padding: 6px 8px;
  margin-top: 12px;
}

.product h3 {
  margin: 10px 0 5px;
  font-size: 19px;
}

.description {
  color: #655e50;
  font-size: 13px;
  line-height: 1.5;
  min-height: 40px;
}

.old-price {
  color: #888;
  text-decoration: line-through;
  font-size: 14px;
}

.price {
  color: #d52b16;
  font-size: 25px;
  font-weight: 900;
  margin-top: 4px;
}

.rating {
  color: #a56b00;
  font-size: 13px;
}

.category {
  background: #e5ffd8;
  border: 2px solid #252015;
  padding: 18px;
  margin-top: 30px;
}

footer {
  background: #252015;
  color: white;
  text-align: center;
  padding: 28px 15px;
  margin-top: 40px;
  font-size: 13px;
  line-height: 1.8;
}

footer a { color: #ffda46; }

@media (max-width: 500px) {
  nav a {
    display: inline-block;
    margin: 6px;
  }

  main { padding: 14px; }
}
</style>
</head>

<body>

